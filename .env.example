# ── قاعدة البيانات ───────────────────────────────────────────────────────
# الإنتاج: تُضاف تلقائياً في Vercel عبر تكامل Neon (Storage → Create Database).
# محلياً: شغّل  npm run db:local  ثم استخدم القيم أدناه كما هي.
POSTGRES_PRISMA_URL="postgresql://qaati:qaati@localhost:54329/qaati"
POSTGRES_URL_NON_POOLING="postgresql://qaati:qaati@localhost:54329/qaati"

# ── المصادقة ──────────────────────────────────────────────────────────────
# ولّد واحداً بـ:  openssl rand -base64 32
AUTH_SECRET="ضع-هنا-سلسلة-عشوائية-طويلة"

# ── لوحة المشغّل (Platform) — لإدارة المشتركين من القاعات ─────────────────
# دخول منفصل عن المستأجرين على /platform. اترك فارغاً لتعطيلها.
PLATFORM_ADMIN_EMAIL="you@example.com"
PLATFORM_ADMIN_PASSWORD="اختر-كلمة-مرور-قوية"

# ── إعدادات عامة (اختيارية) ───────────────────────────────────────────────
TRIAL_DAYS="14"
