# ── قاعدة البيانات (Neon Postgres) ────────────────────────────────────────
# أنشئ مشروع مجاني على https://neon.tech ثم انسخ رابطي الاتصال:
#  - DATABASE_URL : الرابط المُجمّع (Pooled) — يُستخدم وقت التشغيل
#  - DIRECT_URL   : الرابط المباشر (Direct)  — يُستخدم للـ migrations
# في Neon: صفحة المشروع → Connect → انسخ "Pooled connection" و "Direct connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── المصادقة ──────────────────────────────────────────────────────────────
# مفتاح توقيع الجلسات (JWT). ولّد واحداً بـ:  openssl rand -base64 32
AUTH_SECRET="ضع-هنا-سلسلة-عشوائية-طويلة"

# ── لوحة المشغّل (Platform) — لإدارة المشتركين من القاعات ─────────────────
# دخول منفصل عن المستأجرين على /platform. اترك فارغاً لتعطيلها.
PLATFORM_ADMIN_EMAIL="you@example.com"
PLATFORM_ADMIN_PASSWORD="اختر-كلمة-مرور-قوية"

# ── إعدادات عامة (اختيارية) ───────────────────────────────────────────────
# طول فترة التجربة المجانية بالأيام
TRIAL_DAYS="14"
# رقم واتساب المنشأة الافتراضي للتذكيرات (صيغة دولية بدون +)
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="973"
